---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";

// NOTE: copy below is STRUCTURAL PLACEHOLDER (design doc T3/T4 — written with
// the founder). It respects the locked word-choice constraints already:
//   - no "capital / funding / grants / investment" language
//   - no NDA names (Biobadamex / Zamora / SER / CMR)
//   - no Token Dad branding
// Fill each block with real copy; keep the constraints.
---

<Base title="Request for Regens — Regen Accelerator">
  <header class="hero">
    <div class="container">
      <p class="kicker">Regen Accelerator</p>
      <h1>Request for <span class="headline-italic">Regens</span></h1>
      <p class="lede prose">
        Learn to build regeneration with AI. Real tools, real guidance, and a
        public record of what gets built — for builders, impact projects, and
        founders who need help getting from idea to shipped.
      </p>
    </div>
  </header>

  <Section id="what" kicker="What this is" title="A learning surface, not an application form">
    <p>
      [PLACEHOLDER — T4] Teach-first, in the open. This is where you learn how
      the work actually gets done: the tools, the process, the decisions. Not a
      form to fill out, not a queue to wait in — a place to learn from real
      builds that already shipped.
    </p>
  </Section>

  <Section id="dnai" kicker="Proof · Case 01" title="DNAI — a builder agent that ships">
    <p>
      [PLACEHOLDER — T4] DNAI is the builder agent behind real, published work.
      Cite the public artifacts and the preprint (DOI
      <code>10.55277/researchhub.eoe1iia0.1</code>) here. Public-safe only.
    </p>
  </Section>

  <Section id="caregiver" kicker="Proof · Case 02" title="A caregiver surface, built by a learner">
    <p>
      [PLACEHOLDER — T4] Someone learning with these tools is building a
      caregiver-coordination surface — managing overwhelming care instructions
      and coordinating one patient's care across several caregivers. Tell that
      story here.
    </p>
  </Section>

  <Section id="roadmap" kicker="What's next" title="Where this goes">
    <p>
      [PLACEHOLDER — T4] Name the direction without promising specific
      technology or timelines: per-project agents you can spin up on demand, a
      way to track what's being built. Coming, not live.
    </p>
  </Section>

  <footer class="site-footer">
    <div class="container">
      <p>Regen Accelerator · voiced by Reggie</p>
    </div>
  </footer>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 12vh, 9rem) 4rem;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    margin: 0 0 1.5rem;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary); /* Ultra Violet */
    margin: 0 0 0.75rem;
  }
  .lede {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    color: var(--muted-foreground);
  }
  .site-footer {
    padding-block: 3rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }
</style>
