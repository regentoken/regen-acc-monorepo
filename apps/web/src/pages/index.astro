---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import RevealTeaser from "../components/RevealTeaser.astro";

// STRUCTURE is now v1-shaped: navbar, logo, hero with primary-red CTAs, cards,
// the reveal moment, footer). Word-choice constraints hold:
//   no capital/funding/grants/investment · no NDA names · no Token Dad.
// Voice: regen/acc + regenmaxxing, mushroom-mycelial, playful-but-credible.
---

<Base title="Request for Regens: Regen Accelerator">
  <Navbar />

  <!-- HERO -->
  <header class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker">regen/acc · regenmaxxing</p>
        <h1>
          Request for <span class="headline-italic">Regens</span>
        </h1>
        <p class="lede prose">
          Learn to build regeneration with AI: real tools, real guidance, and a
          public record of what gets shipped.
        </p>
        <div class="cta-row">
          <Button href="#cases" size="lg">See the proof</Button>
          <Button href="#what" size="lg" variant="outline">How it works</Button>
        </div>
      </div>
      <div class="hero-art">
        <img src="/logos/reggie.svg" alt="Reggie, a regenerative mushroom" width="260" height="260" />
      </div>
    </div>
  </header>

  <!-- WHAT THIS IS -->
  <Section id="what" title="A learning surface, not an application form">
    <p class="prose">
      Learn by doing, in the open. This is where you master AI-powered
      regeneration: the tools, the process, the decisions that move things. No
      forms, no waiting. A live curriculum built around real projects that have
      already shipped, and the regenmaxxing mindset: using AI like the top
      builders do, focused on what makes life more human.
    </p>
  </Section>

  <!-- CASES (cards) -->
  <Section id="cases" kicker="Proof" title="Real builds, already shipped" center>
    <div class="card-grid">
      <Card kicker="Case 01" title="DNAI: a builder agent that ships" data-reveal style="transition-delay: 0ms">
        <p>
          DNAI is an AI agent that builds and ships real software for regenerative
          projects. It’s created public artifacts used by real teams, and its
          approach is documented in a peer-reviewed preprint (DOI
          <code>10.55277/researchhub.eoe1iia0.1</code>). This is proof that AI
          can drive meaningful impact when guided by the right principles.
        </p>
      </Card>
      <Card
        kicker="Case 02"
        title="A caregiver surface, built by a learner"
        data-reveal
        style="transition-delay: 100ms"
      >
        <p>
          A builder learning with these tools created a caregiver-coordination
          platform that simplifies complex care instructions and synchronizes
          communication across multiple caregivers for one patient. It turns
          overwhelming spreadsheets into a cohesive, human-centered system,
          built entirely through regenmaxxing methods, start to finish.
        </p>
      </Card>
    </div>
  </Section>

  <!-- ROADMAP + REVEAL -->
  <Section id="roadmap" title="Where this goes">
    <div class="roadmap-grid">
      <div data-reveal>
        <p class="prose">
          The vision is clear: on-demand per-project agents, each trained on
          community knowledge and ready to accelerate real-world building. Paired
          with a transparent public ledger of what’s being created, this becomes
          a self-sustaining ecosystem of regenerative innovation. Coming soon.
        </p>
      </div>
      <div data-reveal style="transition-delay: 100ms">
        <RevealTeaser />
      </div>
    </div>
  </Section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="flex items-center gap-x-2.5">
        <img src="/logos/reggie.svg" alt="" width="28" height="28" class="h-7 w-7" />
        <span class="wordmark">Regen Accelerator</span>
      </div>
      <p class="footer-tag">voiced by Reggie · Regenerating frontier tech to make life more human</p>
    </div>
  </footer>
</Base>

<script>
  // The one motion layer beyond hover states: a restrained fade-up as
  // [data-reveal] blocks (proof cards, the roadmap block) enter the
  // viewport. Respects prefers-reduced-motion by revealing immediately.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const targets = document.querySelectorAll("[data-reveal]");

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vh, 5.5rem) clamp(3rem, 7vh, 4.5rem);
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 3.5rem;
    }
  }
  .hero h1 {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    margin: 0 0 1.5rem;
  }
  .hero-art {
    display: flex;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .hero-art {
      justify-content: flex-end;
    }
  }
  .hero-art img {
    width: clamp(180px, 22vw, 300px);
    height: auto;
    transition: transform 0.3s ease;
  }
  .hero-art img:hover {
    transform: scale(0.94);
  }
  .lede {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--muted-foreground);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .card-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 800px) {
    .card-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .roadmap-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .roadmap-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .site-footer {
    padding-block: 3rem;
    border-top: 1px solid var(--border);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }
  @media (min-width: 700px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .wordmark {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 1.15rem;
  }
  .footer-tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted-foreground);
    margin: 0;
  }
</style>