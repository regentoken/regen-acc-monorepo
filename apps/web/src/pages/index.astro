---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import RevealTeaser from "../components/RevealTeaser.astro";
import RevealScript from "../components/RevealScript.astro";
import CtaForm from "../components/CtaForm.astro";

// Request for Regens — the ask itself, RFP/RFS-styled (v2 pivot, 2026-08-05).
// Three doors, not one form: submit an idea, join the mentoring community, or
// become a sponsor. Mentoring and sponsorship stay low-friction; submitting an
// idea carries real friction (an invite code) because it costs real founder
// attention. Proof and the full founder narrative live on /about, not here.
// Constraints: no capital/funding/grants/investment; no NDA names; no Token
// Dad; no em-dash in copy. Aura rules from the OG: compact centered clusters,
// narrow reading columns, whitespace rhythm (no dividers), red-outlined
// panels, italic-emphasis headings, one accent that acts.
---

<Base title="Request for Regens: Regen Accelerator">
  <Navbar />

  <!-- HERO: compact centered cluster, the ask stated plainly -->
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>
          Request for <span class="headline-italic">Regens</span>
        </h1>
        <p class="hero-lede">
          I am one founder who cannot help every builder alone, so here is the
          actual ask: submit an idea, join the mentoring community, or help
          the tools and time go further.
        </p>
        <div class="cta-row">
          <Button href="#submit" size="lg">Submit an idea</Button>
          <Button href="/about" size="lg" variant="outline">Read the story</Button>
        </div>
      </div>
      <div class="hero-art">
        <img
          src="/logos/reggie.svg"
          alt="Reggie, a regenerative mushroom"
          width="240"
          height="240"
        />
      </div>
    </div>
  </header>

  <!-- WHY: the founder-voiced framing for three doors, not one form -->
  <Section id="why">
    <h2 slot="heading">
      Why I'm asking for <span class="headline-italic">regens</span>
    </h2>
    <p>
      There are more builders who need real help than I have hours in a day.
      So this page is the actual ask, not a mission statement: three doors,
      each proportional to what it costs me. Mentoring and sponsorship stay
      low friction. Submitting an idea gets my real attention, so it asks a
      little more of you too.
    </p>
  </Section>

  <!-- ASK 1: submit an idea (the scored assessment IS the submission) -->
  <Section id="submit">
    <h2 slot="heading">
      How <span class="headline-italic">regen</span> is your idea
    </h2>
    <p>
      Tell me what you are building and why it matters. I read every
      submission myself and score it, Reggie-voiced. This door needs an
      invite code, since it is the one that costs me real time to open.
    </p>
    <CtaForm
      type="idea"
      descriptionLabel="What are you building, and why does it matter?"
      descriptionPlaceholder="regenmaxxing an idea into something real..."
      submitLabel="Submit your idea"
    />
  </Section>

  <!-- ASK 2: join the mentoring community -->
  <Section id="mentor">
    <h2 slot="heading">
      Join the <span class="headline-italic">mentoring</span> community
    </h2>
    <p>
      Low friction, high upside. Tell me who you are and what kind of help
      you are looking for, and you are in the network.
    </p>
    <CtaForm
      type="mentorship"
      descriptionLabel="What kind of mentoring are you looking for?"
      submitLabel="Join the community"
    />
  </Section>

  <!-- ASK 3: become a sponsor. Pitch artifact, not a claim anyone signed. -->
  <Section id="sponsor">
    <h2 slot="heading">
      Become a <span class="headline-italic">sponsor</span>
    </h2>
    <p>
      This is the pitch, not a claim anyone has signed on to yet. If you have
      tools, credits, or amplification to put behind builders doing real
      work, tell me what you have in mind.
    </p>
    <CtaForm
      type="sponsorship"
      descriptionLabel="What would you like to sponsor, and how?"
      submitLabel="Start the conversation"
    />
  </Section>

  <!-- ROADMAP + REVEAL -->
  <Section id="roadmap" wide>
    <h2 slot="heading">
      Where this <span class="headline-italic">goes</span>
    </h2>
    <div class="roadmap-grid">
      <div data-reveal>
        <p>
          Per-project agents you can spin up on demand, each grounded in real
          community knowledge, and a public record of what everyone is building.
          Not promised, not dated, but the direction is set.
        </p>
      </div>
      <div data-reveal style="transition-delay: 90ms">
        <RevealTeaser />
      </div>
    </div>
  </Section>

  <!-- CLOSING: resolve on the mission, not on "reveal soon" -->
  <section class="closing">
    <div class="closing-inner">
      <h2>
        Regenerating frontier tech to make life
        <span class="headline-italic">more human</span>.
      </h2>
      <p class="closing-tag">slightly less degen. a lot more regen.</p>
    </div>
  </section>

  <Footer />
</Base>

<RevealScript />

<style>
  /* HERO — the OG's compact, centered cluster. Constrained width is what kills
     the void: the mushroom sits beside the promise, not across a chasm. */
  .hero {
    max-width: var(--container-wide-2); /* OG hero grid: lg:max-w-3xl (48rem) */
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: clamp(3rem, 8vh, 5rem) clamp(2.5rem, 6vh, 4rem);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-block-gap);
    align-items: center;
    justify-items: center;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 2.5rem;
      justify-items: start;
      text-align: left;
    }
  }
  .hero h1 {
    font-size: clamp(2.75rem, 6.5vw, 4rem);
    margin: 0 0 1.25rem;
  }
  .hero-lede {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--muted-foreground);
    max-width: 36ch;
    margin: 0;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .cta-row {
      justify-content: flex-start;
    }
  }
  .hero-art {
    display: flex;
    justify-content: center;
  }
  .hero-art img {
    width: clamp(9.375rem, 20vw, 13.75rem); /* 150px–220px, in rem */
    height: auto;
    transition: transform 0.3s ease;
  }
  .hero-art img:hover {
    transform: scale(0.9); /* the OG signature: Reggie shrinks, not grows */
  }

  /* ROADMAP — prose beside the mycelial reveal. */
  .roadmap-grid {
    display: grid;
    gap: var(--space-block-gap);
    align-items: center;
  }
  @media (min-width: 900px) {
    .roadmap-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* CLOSING — a centered statement that lands the page on the mission. */
  .closing {
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
    text-align: center;
  }
  .closing-inner {
    max-width: var(--container-wide-2); /* was an unlinked 46rem */
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .closing h2 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin: 0;
  }
  .closing-tag {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--secondary);
  }
</style>
