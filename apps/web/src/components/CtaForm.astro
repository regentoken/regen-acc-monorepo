---
import { actions } from "astro:actions";

interface Props {
  type: "idea" | "mentorship" | "sponsorship";
  descriptionLabel: string;
  descriptionPlaceholder?: string;
  submitLabel: string;
}

const { type, descriptionLabel, descriptionPlaceholder, submitLabel } = Astro.props;
const result = Astro.getActionResult(actions.submit);
const formId = `cta-form-${type}`;
---

<form id={formId} class="cta-form" method="POST" action={actions.submit}>
  <input type="hidden" name="type" value={type} />

  <!-- Honeypot: hidden from sighted users, left blank by them; bots that
       autofill every field trip it and get a silent success (see the
       action handler). -->
  <div class="hp-field" aria-hidden="true">
    <label for={`${formId}-website`}>Website</label>
    <input id={`${formId}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <label class="field">
    <span>{descriptionLabel}</span>
    <textarea name="description" required placeholder={descriptionPlaceholder}></textarea>
  </label>

  <label class="field">
    <span>Proof of work (optional)</span>
    <input type="url" name="proofUrl" placeholder="https://..." />
  </label>

  {
    type === "idea" && (
      <label class="field">
        <span>Invite code</span>
        <input type="text" name="inviteCode" required autocomplete="off" />
      </label>
    )
  }

  <div class="field-row">
    <label class="field">
      <span>Name</span>
      <input type="text" name="contactName" required />
    </label>
    <label class="field">
      <span>Contact platform</span>
      <input type="text" name="contactPlatform" placeholder="email, telegram, x" required />
    </label>
    <label class="field">
      <span>Contact value</span>
      <input type="text" name="contactValue" placeholder="you@example.com or @handle" required />
    </label>
  </div>

  <button type="submit" class="cta-submit">{submitLabel}</button>

  {
    result?.error && (
      <p class="form-error" role="alert">
        {result.error.message}
      </p>
    )
  }
  {result && !result.error && <p class="form-success">Got it — thank you.</p>}
</form>

<style>
  .cta-form {
    display: grid;
    gap: 1rem;
  }
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .field {
    display: grid;
    gap: 0.375rem;
    font-size: 0.9rem;
  }
  .field span {
    font-weight: 500;
    color: var(--foreground);
  }
  .field input,
  .field textarea {
    border: 1.5px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    font: inherit;
    background: var(--background);
    color: var(--foreground);
  }
  .field textarea {
    min-height: 6rem;
    resize: vertical;
  }
  .field-row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .field-row {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .cta-submit {
    justify-self: start;
    border: none;
    border-radius: 0.5rem;
    padding: 0.7rem 1.5rem;
    font-weight: 600;
    background: var(--primary);
    color: var(--primary-foreground);
    cursor: pointer;
  }
  .cta-submit:hover {
    background: color-mix(in oklab, var(--primary) 75%, transparent);
  }
  .form-error {
    color: var(--destructive);
    font-size: 0.85rem;
    margin: 0;
  }
  .form-success {
    color: var(--secondary);
    font-size: 0.85rem;
    margin: 0;
  }
</style>
