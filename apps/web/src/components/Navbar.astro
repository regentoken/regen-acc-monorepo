---
// Navbar — the OG regen.tips bar: an 80px header (h-20), the mushroom mark at
// OG scale next to the regen/acc wordmark, and quiet anchor links that turn
// Munsell Red on hover. No CTA button: the hero owns the call, and the OG's
// right slot was a wallet action we don't carry here.
//
// Absolute hrefs (not bare `#anchor`) so the nav resolves the same from
// /about as it does from the homepage.
import Wordmark from "./Wordmark.astro";

const NAV = [
  { label: "idea", href: "/#submit" },
  { label: "mentor", href: "/#mentor" },
  { label: "sponsor", href: "/#sponsor" },
  { label: "about", href: "/about" },
];
---

<header class="sticky top-0 z-20 w-full border-b border-border/50 bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-20 w-full max-w-6xl items-center justify-between px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-x-3">
      <img
        src="/logos/reggie.svg"
        alt="Reggie, a regenerative mushroom"
        width="48"
        height="48"
        class="h-12 w-12 transition duration-300 ease-in-out group-hover:scale-90"
      />
      <Wordmark class="text-xl font-semibold tracking-tight" />
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        NAV.map((item) => (
          <a href={item.href} class="nav-link text-lg font-medium">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav-link {
    color: var(--foreground);
    transition: color 0.15s ease;
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--primary); /* Munsell Red */
    outline: none;
  }
</style>
