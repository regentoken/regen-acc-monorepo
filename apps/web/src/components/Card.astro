---
// Card — the OG regen.tips panel: rounded-lg with a 2px Munsell Red border and
// no shadow. The red-outlined panel (not a soft gray shadowed card) is the
// signature surface. Rest props forward `data-reveal` / inline delay.
interface Props {
  title?: string;
  class?: string;
  [attr: string]: unknown;
}
const { title, class: cls = "", ...rest } = Astro.props;
---

<article
  class={`rounded-lg border-2 border-primary bg-card p-6 md:p-8 ${cls}`}
  {...rest}
>
  {title && <h3 class="mb-3 text-2xl md:text-3xl">{title}</h3>}
  <div class="text-card-foreground/85 leading-relaxed">
    <slot />
  </div>
</article>
