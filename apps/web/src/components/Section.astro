---
interface Props {
  id?: string;
  kicker?: string;
  title?: string;
}
const { id, kicker, title } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    {kicker && <p class="kicker">{kicker}</p>}
    {title && <h2 class="section-title">{title}</h2>}
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: 6rem;
    border-top: 1px solid var(--border);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary); /* Ultra Violet */
    margin: 0 0 0.75rem;
  }
  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1.5rem;
  }
  .section-body {
    max-width: 68ch;
  }
</style>
