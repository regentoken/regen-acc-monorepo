---
// Section — the shared page block, rebuilt to the OG regen.tips aura: a
// narrow, centered column floating in generous side whitespace, with the
// heading carried by an italic-emphasis span (a `heading` slot) rather than a
// mono eyebrow. `wide` widens the column for two-up content (cases, roadmap).
interface Props {
  id?: string;
  title?: string;
  wide?: boolean;
}
const { id, title, wide = false } = Astro.props;
---

<section id={id} class:list={["section", { wide }]}>
  <div class="section-inner">
    <slot name="heading">{title && <h2>{title}</h2>}</slot>
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section-inner {
    width: 100%;
    max-width: var(--container-narrow); /* ~65ch reading column, centered like the OG */
    margin-inline: auto;
    padding-inline: var(--space-mobile-inset);
    display: flex;
    flex-direction: column;
    gap: var(--space-block-gap);
  }
  @media (min-width: 640px) {
    .section-inner {
      padding-inline: 1.5rem; /* OG sm:px-6 */
    }
  }
  /* `wide` steps across breakpoints like the OG's two-up blocks — it never
     sits at one fixed width. */
  .section.wide .section-inner {
    max-width: var(--container-wide-1);
  }
  @media (min-width: 1024px) {
    .section.wide .section-inner {
      max-width: var(--container-wide-2);
    }
  }
  @media (min-width: 1280px) {
    .section.wide .section-inner {
      max-width: var(--container-wide-3);
    }
  }
  .section-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-para-gap); /* OG paragraph rhythm gap-y-4 */
  }
</style>
