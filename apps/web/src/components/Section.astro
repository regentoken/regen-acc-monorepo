---
// Section — the shared page-block wrapper. Vertical rhythm comes from the
// global `.section` class (styles/global.css), so this and any hand-built
// `<section class="section">` block share one rhythm scale.
interface Props {
  id?: string;
  kicker?: string;
  title?: string;
  center?: boolean;
  prose?: boolean;
}
const { id, kicker, title, center = false, prose = false } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    {kicker && <p class:list={["kicker", { "text-center": center }]}>{kicker}</p>}
    {title && <h2 class:list={["section-title", { "text-center": center }]}>{title}</h2>}
    <div class:list={["section-body", { prose, "mx-auto": center && prose }]}>
      <slot />
    </div>
  </div>
</section>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary); /* Ultra Violet */
    margin: 0 0 0.75rem;
  }
  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1.5rem;
  }
  .section-body.prose {
    max-width: 68ch;
  }
</style>
