# Hoisted (flat) node_modules. pnpm's default isolated/symlinked layout doesn't
# reliably expose native optional binaries (@tailwindcss/oxide, lightningcss) to
# the bundled config loaders on Linux/CI — builds fail with "Cannot find native
# binding". A hoisted layout (npm-like) resolves them. We stay on pnpm
# exclusively; this only changes node_modules layout. (Same rationale as
# pokta-care-monorepo.)
node-linker=hoisted
